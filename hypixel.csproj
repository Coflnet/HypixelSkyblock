<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CS8981</NoWarn>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Version>1.0.2</Version>
    <PackageId>Coflnet.Sky.Core</PackageId>
    <!-- The Web SDK turns every *.json into a Content item and packs Content as contentFiles.
         1.0.0/1.0.1 shipped custom.conf.json (live credentials) and whole Tests/bin trees that way. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);custom.conf.json;keyfile.p12;Tests/bin/**;Tests/obj/**;NEU-REPO/**</DefaultItemExcludes>
    <Description>Hypixel Skyblock core library</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Never pack configuration or data files; only the assembly belongs in the package. -->
    <Content Update="**\*.json" Pack="false" />
    <Content Update="**\*.config" Pack="false" />
    <None Update="**\*.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCoreRateLimit.Redis" Version="2.0.0" />
    <PackageReference Include="Coflnet.Core" Version="0.7.4" />
    <PackageReference Include="Coflnet.Sky.Items.Client" Version="0.21.3" />
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    <PackageReference Include="fNbt-netcore" Version="0.6.5" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="Microsoft.TestPlatform.TestHost" Version="18.11.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.1" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.13" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="RateLimiter" Version="2.2.0" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
    <PackageReference Include="SimplerConfig" Version="1.0.4" />
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Newtonsoft" Version="10.3.1" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.14" />


    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />

    <!--None Include="custom.conf.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <None Include="appsettings.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <None Include="keyfile.p12" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" /-->
  </ItemGroup>
</Project>